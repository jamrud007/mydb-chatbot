# Docker Environment Variables Template
# Copy this to .env and update with your actual values

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=chatbot_user
DB_PASSWORD=changeme123
DB_NAME=ecommerce_olist

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TYPE=redis
CACHE_DEFAULT_TTL=604800

# Application Configuration
DEBUG=False
READ_ONLY_MODE=True
LOG_LEVEL=INFO

# AI Provider Configuration
AI_PROVIDER=openai
AI_FALLBACK_PROVIDERS=

# OpenRouter / OpenAI Configuration
OPENAI_API_KEY=your-openrouter-api-key-here
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Gemini Configuration (if using direct)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration (if using local)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60

# Query Settings
MAX_RESULTS=100
DEFAULT_LIMIT=10

# Port Configuration (for docker-compose)
BACKEND_PORT=8000
FRONTEND_PORT=8501
