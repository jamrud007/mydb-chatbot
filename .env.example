# ============================================================================
# MySQL Chatbot - Environment Configuration
# ============================================================================
# 📝 INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Update values below with your actual credentials
#   3. Never commit .env to git (already in .gitignore)
#
# 🔒 SECURITY:
#   - Use strong passwords (16+ chars, mixed case, numbers, symbols)
#   - Keep API keys secret
#   - Set DEBUG=False in production
# ============================================================================

# ============================================================================
# 🚀 APPLICATION SETTINGS
# ============================================================================

# DEBUG: Show detailed error messages?
# ⚙️ Options: True (development) | False (production)
# ⚠️ IMPORTANT: Set to False in production to hide sensitive errors!
DEBUG=False

# READ_ONLY_MODE: Allow database modifications?
# ⚙️ Options: True (safe, SELECT only) | False (allow INSERT/UPDATE/DELETE)
# ✅ RECOMMENDED: True for production to protect your data
READ_ONLY_MODE=True

# LOG_LEVEL: How much logging detail?
# ⚙️ Options: DEBUG (everything) | INFO (normal) | WARNING (important) | ERROR (errors only)
# 💡 TIP: Use DEBUG for development, WARNING for production
LOG_LEVEL=INFO

# ============================================================================
# 🗄️ DATABASE CONFIGURATION
# ============================================================================

# DB_HOST: Where is your MySQL database?
# 📍 Examples:
#   - localhost (local development)
#   - mysql (Docker container name)
#   - prod-db.example.com (production server)
#   - 192.168.1.10 (IP address)
DB_HOST=localhost

# DB_PORT: MySQL port number
# 📌 Default: 3306 (rarely needs changing)
DB_PORT=3306

# DB_USER: Database username
# 👤 Examples:
#   - root (development only!)
#   - chatbot_user (production - create separate user)
# 💡 TIP: Create read-only user for production: 
#   CREATE USER 'chatbot_user'@'%' IDENTIFIED BY 'password';
#   GRANT SELECT ON database.* TO 'chatbot_user'@'%';
DB_USER=root

# DB_PASSWORD: Database password
# 🔐 CRITICAL: Use STRONG password in production!
# ❌ BAD: password123, admin, root
# ✅ GOOD: Xy9$mK2#pL4@nR7! (16+ chars, mixed)
# 🚨 NEVER commit real password to git!
DB_PASSWORD=your_secure_password_here

# DB_NAME: Which database to use?
# 📊 This is your database name containing the tables
# Example: ecommerce_olist, my_database, company_db
DB_NAME=ecommerce_olist

# ============================================================================
# 🤖 AI PROVIDER CONFIGURATION (Choose ONE)
# ============================================================================

# AI_PROVIDER: Which LLM service to use?
# ⚙️ OPTIONS:
#   1. "openai" = OpenRouter (Gemini via gateway) ⭐ RECOMMENDED
#      🎯 Best for: Production, flexibility
#      💰 Cost: $0.075/1M tokens (~$5-15/month)
#      ✅ Pros: Multiple models, pay-as-you-go, reliable
#
#   2. "gemini" = Google Gemini Direct 🆓 FREE TIER!
#      🎯 Best for: Low usage, testing
#      💰 Cost: FREE (1M tokens/day) + $300 credit
#      ✅ Pros: Free tier, fast, accurate
#
#   3. "ollama" = Local LLM (runs on your computer) 🆓 FREE
#      🎯 Best for: Privacy, offline, unlimited use
#      💰 Cost: $0 (but needs RTX 3060+ GPU, 36GB RAM)
#      ⚠️ Cons: Requires powerful hardware
#
#   4. "deepseek" = DeepSeek API 💰 CHEAPER
#      🎯 Best for: Budget-conscious
#      💰 Cost: $0.14/1M tokens
AI_PROVIDER=openai

# --- 📡 OPTION 1: OpenRouter (Recommended) ---
# 🔑 Get API key: https://openrouter.ai/keys
# 💵 Add credit: $5-10 (lasts months with caching)
# 📖 Models: https://openrouter.ai/models
OPENAI_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- 📡 OPTION 2: Gemini Direct ---
# 🔑 Get API key: https://aistudio.google.com/app/apikey
# 🎁 FREE: 1M tokens/day + $300 credit (90 days)
# 💡 Perfect for: Testing, low usage (<1000 queries/month)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# --- 📡 OPTION 3: Ollama Local ---
# 📥 Install: https://ollama.ai/download
# 💻 Run: ollama pull llama3.1:8b
# 🖥️ Requires: RTX 3060 12GB VRAM, 36GB RAM, 1TB SSD
# ⚠️ Check: ollama_requirements.md for details
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ============================================================================
# ⚡ CACHE CONFIGURATION (Saves 70% of LLM costs!)
# ============================================================================

# CACHE_TYPE: Where to store cached query results?
# ⚙️ OPTIONS:
#   - "sqlite" = Local file (simple, good for 1 server) ⭐ DEFAULT
#   - "redis" = Distributed cache (best for multiple servers)
# 💡 TIP: Use sqlite for dev/small production, redis for scale
CACHE_TYPE=sqlite

# CACHE_DEFAULT_TTL: How long to keep cached results? (seconds)
# 💡 EXAMPLES:
#   - 3600 = 1 hour (development)
#   - 86400 = 1 day (testing)
#   - 604800 = 7 days (production) ⭐ RECOMMENDED
# 💰 SAVINGS: Longer cache = lower LLM costs!
# ⚠️ NOTE: Old data stays cached until TTL expires
CACHE_DEFAULT_TTL=604800

# --- Redis Settings (only if CACHE_TYPE=redis) ---
# 🔧 Install Redis: https://redis.io/download
# 🐳 Docker: docker run -d -p 6379:6379 redis:alpine
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ============================================================================
# 🛡️ RATE LIMITING (Prevent abuse & control costs)
# ============================================================================

# RATE_LIMIT_REQUESTS: Max requests allowed per period
# 💡 EXAMPLES:
#   - 100 = Development (no limit)
#   - 20 = Staging (realistic testing)
#   - 10 = Production (prevent abuse) ⭐ RECOMMENDED
# 🎯 PURPOSE: Stops users from spamming expensive LLM calls
RATE_LIMIT_REQUESTS=10

# RATE_LIMIT_PERIOD: Time window for rate limit (seconds)
# 💡 EXAMPLES:
#   - 60 = per minute (common)
#   - 3600 = per hour
# 📊 WITH SETTINGS ABOVE: 10 requests per 60 seconds = max 10/minute
RATE_LIMIT_PERIOD=60

# MAX_REQUESTS_PER_MINUTE: Max requests per minute (used by Config.MAX_REQUESTS_PER_MINUTE)
MAX_REQUESTS_PER_MINUTE=10

# RATE_LIMIT_TIME_WINDOW: Sliding window duration in seconds (used by Config.RATE_LIMIT_TIME_WINDOW)
RATE_LIMIT_TIME_WINDOW=60

# RESULTS_CACHE_TTL: How long query results are cached (seconds)
# 💡 3600 = 1 hour (default), 0 = disable result caching
RESULTS_CACHE_TTL=3600

# METRICS_WINDOW_MINUTES: Rolling window for metrics collection (minutes)
METRICS_WINDOW_MINUTES=60

# LLM_TIMEOUT: Max seconds to wait for LLM response
# 💡 600 = 10 minutes (default for large queries), 30 = aggressive cutoff
LLM_TIMEOUT=600

# ============================================================================
# 🔐 JWT AUTHENTICATION SETTINGS
# ============================================================================

# JWT_SECRET_KEY: Secret key for signing JWT tokens
# 🔐 CRITICAL: Use STRONG random string in production!
# 💡 Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ❌ BAD: your-secret-key, password123, change-me
# ✅ GOOD: Xy9mK2pL4nR7qS8tU1vW3xY5zA6bC9dE (random 32+ chars)
# 🚨 NEVER commit real secret to git!
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# JWT_ALGORITHM: Algorithm for JWT signing
# ⚙️ Options: HS256 (default, symmetric) | RS256 (asymmetric, for distributed systems)
# 💡 TIP: Use HS256 unless you need advanced features
JWT_ALGORITHM=HS256

# JWT_EXPIRE_MINUTES: How long JWT tokens are valid (minutes)
# 💡 EXAMPLES:
#   - 30 = 30 minutes (high security environments)
#   - 1440 = 24 hours (recommended) ⭐
#   - 10080 = 7 days (convenience)
# ⚠️ Shorter = more secure, but users re-login more often
JWT_EXPIRE_MINUTES=1440

# ============================================================================
# 📊 QUERY SETTINGS
# ============================================================================

# MAX_RESULTS: Maximum rows returned from any query
# 🎯 PURPOSE: Prevent overwhelming server with huge result sets
# 💡 TIP: 100 is good balance (not too big, not too small)
# ⚠️ NOTE: Queries requesting >100 rows will be limited to 100
MAX_RESULTS=100

# DEFAULT_LIMIT: Auto-add LIMIT if user doesn't specify
# 🎯 PURPOSE: Prevent accidental full table scans
# 💡 EXAMPLE: "SELECT * FROM orders" becomes "SELECT * FROM orders LIMIT 10"
# ⚠️ NOTE: Doesn't apply if user already has LIMIT in query
DEFAULT_LIMIT=10

# ============================================================================
# 📊 MONITORING & LOGGING (Optional - for production)
# ============================================================================

# --- Sentry Error Tracking (Recommended for production) ---
# 📝 Sign up: https://sentry.io/ (free tier available)
# 🎯 PURPOSE: Get notified when errors happen in production
# 💰 COST: Free up to 5K errors/month
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz

# --- Datadog Monitoring (Enterprise) ---
# 📝 Sign up: https://www.datadoghq.com/
# 🎯 PURPOSE: Server monitoring, metrics, dashboards
# 💰 COST: $15-31/host/month
# DATADOG_API_KEY=your-datadog-api-key

# ============================================================================
# 🖥️ FRONTEND / STREAMLIT SETTINGS
# ============================================================================

# BACKEND_URL: URL where the FastAPI backend is running
# 💡 Default: http://localhost:8000 (local development)
# 📡 Production example: https://api.yourdomain.com
BACKEND_URL=http://localhost:8000

# ============================================================================
# ✅ QUICK SETUP CHECKLIST
# ============================================================================
# Before deploying, make sure you:
# [ ] Updated DB_PASSWORD with strong password
# [ ] Added OPENAI_API_KEY or GEMINI_API_KEY
# [ ] Set DEBUG=False for production
# [ ] Set READ_ONLY_MODE=True for production
# [ ] Configured DB_HOST to point to your database
# [ ] Verified .env is in .gitignore (never commit!)
# ============================================================================
