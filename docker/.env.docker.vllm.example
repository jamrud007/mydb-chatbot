# Docker environment variables for vLLM deployment

# ======================================
# vLLM Server Configuration
# ======================================
VLLM_PORT=8080

# ======================================
# Database Configuration
# ======================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme123
DB_NAME=ecommerce_olist
DB_EXTERNAL_PORT=3307

# ======================================
# Redis Configuration
# ======================================
REDIS_HOST=redis
REDIS_PORT=6379

# ======================================
# Backend API Configuration
# ======================================
BACKEND_PORT=5000
AI_PROVIDER=openai
OPENAI_BASE_URL=http://vllm:8080/v1
OPENAI_API_KEY=dummy-key
OPENAI_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ======================================
# Frontend Configuration
# ======================================
FRONTEND_PORT=8501
BACKEND_URL=http://backend:8000

# ======================================
# Application Settings
# ======================================
DEBUG=False
READ_ONLY_MODE=False
MAX_QUERY_ROWS=100
MAX_REQUESTS_PER_MINUTE=10

# ======================================
# Cache Settings
# ======================================
CACHE_ENABLED=True
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=604800

# ======================================
# Fallback Providers (Optional)
# ======================================
# AI_FALLBACK_PROVIDERS=gemini,deepseek
# GEMINI_API_KEY=your_key_here
# DEEPSEEK_API_KEY=your_key_here
