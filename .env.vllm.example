# ======================================
# vLLM + LoRA Configuration Template
# ======================================
# Copy this to .env for vLLM deployment

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ecommerce_olist

# ======================================
# vLLM Configuration
# ======================================
AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=dummy-key
OPENAI_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Fallback providers (if vLLM fails)
AI_FALLBACK_PROVIDERS=gemini,deepseek

# ======================================
# Optional: Gemini Fallback
# ======================================
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-pro

# ======================================
# Optional: DeepSeek Fallback
# ======================================
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ======================================
# Application Settings
# ======================================
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Cache Settings
CACHE_ENABLED=True
CACHE_BACKEND=sqlite
CACHE_SQLITE_PATH=./data/cache.db

# Query Settings
MAX_QUERY_ROWS=100
READ_ONLY_MODE=False

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=10

# ======================================
# vLLM Server Settings (for reference)
# ======================================
# These are used by your local vLLM launch script
# VLLM_HOST=0.0.0.0
# VLLM_PORT=8080
# VLLM_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# VLLM_LORA_PATH=./nl2sql-json-v2-adapter-manual
